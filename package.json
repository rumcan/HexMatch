{
  "name": "hexmatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hexmatch Industries — a 2:1 isometric (dimetric) canvas-2d industry-tycoon game with a WebSocket relay room server.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "slice-atlas": "node tools/slice-atlas.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "^4.1.11"
  }
}
