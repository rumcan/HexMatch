{
  "name": "hexmatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hexmatch Industries — a 3D island strategy / match-3 tycoon game with a WebSocket relay room server.",
  "scripts": {
    "dev": "vite",
    "dev:live": "node tools/dev-live.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/unit/iso-ai-sweep.test.ts --exclude tests/unit/iso-rebalance.test.ts --exclude tests/unit/iso-debug.test.ts --exclude tests/unit/iso-l1d-race.test.ts --exclude tests/unit/battle-ai-sim.test.ts",
    "test:watch": "vitest",
    "test:server": "vitest run tests/unit/server.test.ts",
    "test:slow": "vitest run --testTimeout=60000 tests/unit/iso-ai-sweep.test.ts tests/unit/iso-rebalance.test.ts tests/unit/iso-debug.test.ts tests/unit/iso-l1d-race.test.ts tests/unit/battle-ai-sim.test.ts",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mp": "playwright test --config playwright.multiplayer.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "slice-atlas": "node tools/slice-atlas.mjs && node tools/make-atlas-groups.mjs",
    "atlas:groups": "node tools/make-atlas-groups.mjs",
    "noir-art": "node tools/make-noir-art.mjs",
    "railway-art": "node tools/make-railway-art.mjs",
    "scenery-art": "node tools/make-ground-textures.mjs grass && node tools/make-scenery-art.mjs",
    "ending-art": "node tools/make-ending-art.mjs"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "^5.27.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "5.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "7.3.2",
    "vitest": "^4.1.11"
  }
}
