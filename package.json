{
  "name": "hexmatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hexmatch Industries \u2014 a 3D island strategy / match-3 tycoon game with a WebSocket relay room server.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm --prefix server test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "slice-atlas": "node tools/slice-atlas.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "5.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "7.3.2",
    "vitest": "^4.1.11"
  }
}