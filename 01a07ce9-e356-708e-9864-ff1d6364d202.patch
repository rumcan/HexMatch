+    const hx = ind.tx, hy = ind.ty + ind.h, fy = hy + 6;
+    if (hx < 0 || hx >= MAP_W || fy >= MAP_H) continue;
+    if (!inView(hx, fy) || !inView(hx + 1, fy + 1)) continue;
+    let ok = true;
+    for (let y = hy; y <= fy; y++) {
+      if (buildRefusal(grid, "road", hx, y) !== null) { ok = false; break; }
+      if (!inView(hx, y)) { ok = false; break; }
+      const [x, y2] = at(hx, y);
+      if (topAt(x, y2).kind !== "canvas") { ok = false; break; }
+    }
+    if (!ok) continue;
+    return { hx, hy, fx: hx, fy, dir: "SW", tiles: 7, margin: 0, industry: ind.id, col: [] };
+  }
+  return null;
+}
+
+
+describe("scratch sweep", () => {
+  it("lists good seeds and south-column absence", () => {
+    const out: string[] = [];
+    for (const seed of [3,22,37,40,47,63,79,106,129,132,147,175,176,194,198,199]) {
+      let line = "";
+      try {
+        const { grid } = scene(seed, 1);
+        const c = findIsoCorridor();
+        const old = oldFindSouthColumn(grid);
+        line = `seed ${seed}: ${c.tiles}@${c.dir} f=(${c.fx},${c.fy}) h=(${c.hx},${c.hy}) legacySouth=${old ? "YES" : "no"}`;
+      } catch (e) { line = `seed ${seed}: ERR ${(e as Error).message.slice(0,60)}`; }
+      out.push(line);
+      for (const fn of cleanup) fn(); cleanup = [];
+    }
+    console.log(out.join("\n"));
+    expect(true).toBe(true);
+  });
+});
