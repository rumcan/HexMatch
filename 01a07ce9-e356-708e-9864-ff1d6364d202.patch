+import { describe, it, expect } from "vitest";
+import { generateMap, idx, publicRoadTilesOf, INDUSTRY_ROAD_SEP } from "../../src/iso/grid";
+import { MAP_W, MAP_H } from "../../src/iso/config";
+
+describe("scratch: industry ↔ public road distances", () => {
+  it("reports violations", () => {
+    const seeds = [1337, 7, 42, 79, 100, 1, 123, 2026, 0, 2024, 20260902, 555, 314159, 88, 12, 999];
+    for (const seed of seeds) {
+      const g = generateMap(seed);
+      const roads = new Set(publicRoadTilesOf(g).map(([x, y]) => idx(x, y)));
+      let viol = 0, min = Infinity, moved = 0;
+      const occ = new Int16Array(MAP_W * MAP_H).fill(-1);
+      for (const ind of g.industries) {
+        for (let x = ind.tx; x < ind.tx + ind.w; x++) {
+          for (let y = ind.ty; y < ind.ty + ind.h; y++) {
+            if (occ[y * MAP_W + x] !== -1) moved++;   // overlap counter
+            occ[y * MAP_W + x] = ind.id;
+            for (const r of roads) {
+              const rx = r % MAP_W, ry = (r / MAP_W) | 0;
+              const d = Math.max(Math.abs(rx - x), Math.abs(ry - y));
+              if (d < min) min = d;
+            }
+          }
+        }
+      }
+      for (const ind of g.industries) {
+        let d = Infinity;
+        for (let x = ind.tx; x < ind.tx + ind.w; x++) {
+          for (let y = ind.ty; y < ind.ty + ind.h; y++) {
+            for (const r of roads) {
+              const rx = r % MAP_W, ry = (r / MAP_W) | 0;
+              d = Math.min(d, Math.max(Math.abs(rx - x), Math.abs(ry - y)));
+            }
+          }
+        }
+        if (d < INDUSTRY_ROAD_SEP) viol++;
+      }
+      // 12-tile separation census + town gap
+      let strict = 0, total = 0, townMin = Infinity;
+      for (let i = 0; i < g.industries.length; i++) {
+        for (let j = i + 1; j < g.industries.length; j++) {
+          const a = g.industries[i], b = g.industries[j];
+          const dx = Math.max(a.tx - (b.tx + b.w - 1), b.tx - (a.tx + a.w - 1));
+          const dy = Math.max(a.ty - (b.ty + b.h - 1), b.ty - (a.ty + a.h - 1));
+          if (Math.max(dx, dy) >= 12) strict++;
+          total++;
+        }
+      }
+      for (const t of g.towns) {
+        for (const [x, y] of [...t.houses, ...t.roads]) {
+          for (const ind of g.industries) {
+            const dx = Math.max(ind.tx - x, 0, x - (ind.tx + ind.w - 1));
+            const dy = Math.max(ind.ty - y, 0, y - (ind.ty + ind.h - 1));
+            townMin = Math.min(townMin, Math.max(dx, dy));
+          }
+        }
+      }
+      console.log(`seed ${seed}: n=${g.industries.length} towns=${g.towns.length} roads=${roads.size} viol=${viol} min=${min} overlap=${moved} sep12=${(strict / total * 100).toFixed(1)}% townMin=${townMin}`);
+      expect(viol, `seed ${seed} highway buffer`).toBe(0);
+      expect(moved, `seed ${seed} overlaps`).toBe(0);
+    }
+  });
+});
+
+void MAP_H;
