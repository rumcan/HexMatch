{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hexmatch-atlas-manifest",
  "title": "HexMatch isometric atlas manifest (E1)",
  "description": "One shared manifest for all scale variants of the sprite atlas (K1 Kenney edition). `anchor` is the pixel inside the sprite that lands exactly on the screen position of the footprint's diamond CENTRE — for ground/standing sprites the measured widest row of the base diamond, for vehicles the bottom-centre. Computed by the packer; never hand-authored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "tileW",
    "tileH",
    "sprites"
  ],
  "properties": {
    "tileW": {
      "type": "integer",
      "minimum": 1
    },
    "tileH": {
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "credits": {
          "type": "string"
        }
      }
    },
    "sprites": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sprite"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "images": {
      "type": "object",
      "description": "Atlas image per zoom level (0.5/1/2). Coordinates & anchors are at 1x.",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sprite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h",
        "footprint",
        "anchor"
      ],
      "properties": {
        "kind": {
          "description": "Anchor class: ground (flat block, widest-row anchor), standing (building, base-diamond anchor) or vehicle (bottom-centre anchor; intentionally smaller than its tile).",
          "type": "string",
          "enum": ["ground", "standing", "vehicle"]
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "frameMs": {
          "type": "integer",
          "minimum": 1
        },
        "footprint": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "anchor": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "slices": {
          "description": "E4 Tier-3 escape hatch: optional per-tile strips for sprites that cannot be depth-sorted as a whole. A slice is an axis-aligned strip with its own sub-rect.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "w": {
                "type": "integer",
                "minimum": 1
              },
              "h": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}