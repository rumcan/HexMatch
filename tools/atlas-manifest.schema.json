{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hexmatch Iso Atlas Manifest",
  "type": "object",
  "required": ["image", "tileW", "tileH", "sprites"],
  "properties": {
    "image": { "type": "string", "minLength": 1 },
    "tileW": { "type": "integer", "minimum": 1 },
    "tileH": { "type": "integer", "minimum": 1 },
    "sprites": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/sprite" }
    }
  },
  "definitions": {
    "sprite": {
      "type": "object",
      "required": ["x", "y", "w", "h", "footprint", "anchor", "frames"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 },
        "footprint": {
          "type": "array", "items": { "type": "integer", "minimum": 1 },
          "minItems": 2, "maxItems": 2
        },
        "anchor": {
          "type": "array", "items": { "type": "integer", "minimum": 0 },
          "minItems": 2, "maxItems": 2
        },
        "frames": { "type": "integer", "minimum": 1 },
        "frameMs": { "type": "integer", "minimum": 1 },
        "slices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer" }, "y": { "type": "integer" },
              "w": { "type": "integer", "minimum": 1 },
              "h": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
